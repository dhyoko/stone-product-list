# Copy this file to .env and change the values for your machine.
# Variables set in the shell win over the values in .env.

# development, test, or production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

AWS_REGION=us-east-1

# Endpoint of a local DynamoDB, such as DynamoDB Local from docker-compose.yml.
# Leave it unset to use the AWS endpoint for AWS_REGION.
DYNAMODB_LOCAL_ENDPOINT=http://localhost:8000

USERS_TABLE=product-api-users
PRODUCTS_TABLE=product-api-products
